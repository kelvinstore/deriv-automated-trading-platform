# PostgreSQL — required
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Deriv API — https://app.deriv.com/  (create an API token with read + trade scopes)
# Never commit real tokens. These are read server-side only and never reach the browser.
DERIV_APP_ID=1089
DERIV_API_TOKEN_DEMO=
DERIV_API_TOKEN_REAL=
